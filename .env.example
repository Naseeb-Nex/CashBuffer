# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Encryption Key (32-byte url-safe base64-encoded bytes string for Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# Local & MCP JWT Secret for Self-Hosted Mode
LOCAL_JWT_SECRET=your_jwt_secret_for_local_mode_here

# Allowed CORS Origins (comma-separated, default is "*" if omitted)
# ALLOWED_ORIGINS=https://cashbuffer.yourdomain.com,http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Kinde Auth (Optional - for Cloud SaaS mode)
# KINDE_DOMAIN=https://your-domain.kinde.com
# KINDE_CLIENT_ID=your_kinde_client_id
# KINDE_CLIENT_SECRET=your_kinde_client_secret
# KINDE_AUDIENCE=https://api.cashbuffer.local

